generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  TEACHER
  ADMIN_STAFF
  MEMBER
}

enum DocumentStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum DocumentCategory {
  DILEKCELER       // Dilekce turleri
  TUTANAKLAR       // Tutanak turleri
  IZIN_FORMLARI    // Izin belgesi
  ZIMMET           // Zimmet formu
  GOREVLENDIRME    // Gorevlendirme yazisi
  YAZISMALAR       // Resmi yazi sablonlari
  SOZLESMELER      // Sozlesme turleri
  RAPORLAR         // Rapor sablonlari
  DIGER            // Diger evrak
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  password      String?
  role          Role       @default(MEMBER)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  documents     Document[]
  templates     Template[] @relation("TemplateCreator")
  favorites     Favorite[]
}

model Template {
  id          String           @id @default(cuid())
  title       String
  slug        String           @unique
  description String?
  category    DocumentCategory
  content     String           @db.Text
  fields      Json             // Variable fields: [{name, label, type, required, placeholder}]
  tags        String[]
  isPublic    Boolean          @default(true)
  isPremium   Boolean          @default(false)
  useCount    Int              @default(0)
  createdById String
  createdBy   User             @relation("TemplateCreator", fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  documents   Document[]
  favorites   Favorite[]

  @@index([category])
  @@index([isPublic])
}

model Document {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  category    DocumentCategory
  content     String         @db.Text
  fieldValues Json           // Filled field values
  status      DocumentStatus @default(DRAFT)
  isAiAssisted Boolean       @default(false)
  templateId  String?
  template    Template?      @relation(fields: [templateId], references: [id])
  authorId    String
  author      User           @relation(fields: [authorId], references: [id])
  pdfPath     String?        // Generated PDF path
  shareToken  String?        @unique
  expiresAt   DateTime?      // Share link expiry
  viewCount   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([authorId])
  @@index([status])
  @@index([shareToken])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  templateId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, templateId])
}
